cmake_minimum_required(VERSION 3.15)

if(NOT DEFINED OUTPUT_DIR)
  message(FATAL_ERROR "generate_mpfr_fortran.cmake requires OUTPUT_DIR")
endif()

set(SW_FLOAT "([0-9]+\\.[0-9]*|\\.[0-9]+|[0-9]+[eEdD][+-]?[0-9]+)([eEdD][+-]?[0-9]+)?(_[kK][nN][dD]1?)?")
set(SW_MODULE_NAME "(^|[^a-zA-Z0-9_])([pP][rR][oO][lL][aA][tT][eE]|[oO][bB][lL][aA][tT][eE]|[cC][oO][mM][pP][lL][eE][xX]_[pP][rR][oO][lL][aA][tT][eE]|[cC][oO][mM][pP][lL][eE][xX]_[oO][bB][lL][aA][tT][eE])_([pP][aA][rR][aA][mM][eE][tT][eE][rR][sS]|[sS][wW][fF])([^a-zA-Z0-9_]|$)")

function(sw_statements source result)
  string(REPLACE ";" "\\;" lines "${source}")
  string(REPLACE "\n" ";" lines "${lines}")
  set(statements)
  set(current "")
  foreach(raw IN LISTS lines)
    string(STRIP "${raw}" code)
    string(TOLOWER "${code}" lower)
    if(lower MATCHES "^!\\$omp")
      if(NOT current STREQUAL "")
        message(FATAL_ERROR "OpenMP directive inside a continued statement")
      endif()
    else()
      if(code MATCHES "^!" OR code STREQUAL "")
        continue()
      endif()
      string(FIND "${code}" "!" comment)
      if(NOT comment EQUAL -1)
        set(quoted "")
        string(LENGTH "${code}" length)
        set(index 0)
        while(index LESS length)
          string(SUBSTRING "${code}" ${index} 1 character)
          if(NOT quoted STREQUAL "")
            if(character STREQUAL quoted)
              set(quoted "")
            endif()
          elseif(character STREQUAL "'" OR character STREQUAL "\"")
            set(quoted "${character}")
          elseif(character STREQUAL "!")
            string(SUBSTRING "${code}" 0 ${index} code)
            break()
          endif()
          math(EXPR index "${index}+1")
        endwhile()
        string(STRIP "${code}" code)
      endif()
      if(code STREQUAL "")
        continue()
      endif()
      if(NOT current STREQUAL "")
        string(REGEX REPLACE "^&+[ \t]*" "" code "${code}")
        string(APPEND current " ")
      endif()
      if(code MATCHES "&$")
        string(REGEX REPLACE "&$" "" code "${code}")
        string(APPEND current "${code}")
        continue()
      endif()
      string(APPEND current "${code}")
      set(code "${current}")
      set(current "")
    endif()
    string(REPLACE ";" "\\;" code "${code}")
    list(APPEND statements "${code}")
  endforeach()
  if(NOT current STREQUAL "")
    message(FATAL_ERROR "Unterminated Fortran continuation")
  endif()
  set(${result} "${statements}" PARENT_SCOPE)
endfunction()

function(sw_split_arguments arguments result)
  set(parts)
  set(depth 0)
  set(begin 0)
  set(quoted "")
  string(LENGTH "${arguments}" length)
  set(index 0)
  while(index LESS length)
    string(SUBSTRING "${arguments}" ${index} 1 character)
    if(NOT quoted STREQUAL "")
      if(character STREQUAL quoted)
        set(quoted "")
      endif()
    elseif(character STREQUAL "'" OR character STREQUAL "\"")
      set(quoted "${character}")
    elseif(character STREQUAL "(")
      math(EXPR depth "${depth}+1")
    elseif(character STREQUAL ")")
      math(EXPR depth "${depth}-1")
    elseif(character STREQUAL "," AND depth EQUAL 0)
      math(EXPR count "${index}-${begin}")
      string(SUBSTRING "${arguments}" ${begin} ${count} part)
      string(STRIP "${part}" part)
      string(REPLACE ";" "\\;" part "${part}")
      list(APPEND parts "${part}")
      math(EXPR begin "${index}+1")
    endif()
    math(EXPR index "${index}+1")
  endwhile()
  string(SUBSTRING "${arguments}" ${begin} -1 part)
  string(STRIP "${part}" part)
  string(REPLACE ";" "\\;" part "${part}")
  list(APPEND parts "${part}")
  set(${result} "${parts}" PARENT_SCOPE)
endfunction()

function(sw_convert_calls text result)
  while(TRUE)
    string(TOLOWER "${text}" lower)
    string(REGEX MATCH "(^|[^a-z0-9_])(real|cmplx|dcmplx|dble)[ \t]*\\(" matched "${lower}")
    if(matched STREQUAL "")
      break()
    endif()
    set(separator "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")
    string(FIND "${lower}" "${matched}" start)
    string(LENGTH "${separator}" separator_length)
    string(LENGTH "${matched}" matched_length)
    math(EXPR begin "${start}+${matched_length}")
    math(EXPR start "${start}+${separator_length}")
    set(end ${begin})
    set(depth 1)
    string(LENGTH "${text}" length)
    while(depth GREATER 0)
      if(end GREATER_EQUAL length)
        message(FATAL_ERROR "Unbalanced conversion call: ${text}")
      endif()
      string(SUBSTRING "${text}" ${end} 1 character)
      if(character STREQUAL "(")
        math(EXPR depth "${depth}+1")
      elseif(character STREQUAL ")")
        math(EXPR depth "${depth}-1")
      endif()
      math(EXPR end "${end}+1")
    endwhile()
    math(EXPR count "${end}-${begin}-1")
    string(SUBSTRING "${text}" ${begin} ${count} arguments)
    sw_split_arguments("${arguments}" arguments)
    set(converted)
    foreach(argument IN LISTS arguments)
      string(TOLOWER "${argument}" lower_argument)
      if(NOT lower_argument MATCHES "^(kind[ \t]*=[ \t]*)?knd1?$")
        sw_convert_calls("${argument}" argument)
        string(REPLACE ";" "\\;" argument "${argument}")
        list(APPEND converted "${argument}")
      endif()
    endforeach()
    list(JOIN converted ", " arguments)
    if(name STREQUAL "cmplx" OR name STREQUAL "dcmplx")
      set(name "mpcmplx")
    else()
      set(name "mpreal")
    endif()
    string(SUBSTRING "${text}" 0 ${start} prefix)
    string(SUBSTRING "${text}" ${end} -1 suffix)
    set(text "${prefix}${name}(${arguments})${suffix}")
  endwhile()
  set(${result} "${text}" PARENT_SCOPE)
endfunction()

function(sw_complex_literals text result)
  set(output "")
  while(TRUE)
    string(REGEX MATCH "\\([ \t]*([+-]?[ \t]*${SW_FLOAT})[ \t]*,[ \t]*([+-]?[ \t]*${SW_FLOAT})[ \t]*\\)" matched "${text}")
    if(matched STREQUAL "")
      string(APPEND output "${text}")
      break()
    endif()
    set(left "${CMAKE_MATCH_1}")
    set(right "${CMAKE_MATCH_5}")
    string(FIND "${text}" "${matched}" start)
    string(LENGTH "${matched}" count)
    math(EXPR end "${start}+${count}")
    string(SUBSTRING "${text}" 0 ${start} prefix)
    string(APPEND output "${prefix}")
    string(REGEX REPLACE "[ \t]+$" "" prefix "${output}")
    if(prefix MATCHES "[a-zA-Z0-9_)]$")
      string(APPEND output "${matched}")
    else()
      string(APPEND output "mpcmplx(${left}, ${right})")
    endif()
    string(SUBSTRING "${text}" ${end} -1 text)
  endwhile()
  set(${result} "${output}" PARENT_SCOPE)
endfunction()

function(sw_numeric_literals text result)
  set(output "")
  set(previous "")
  while(TRUE)
    string(REGEX MATCH "${SW_FLOAT}" matched "${text}")
    if(matched STREQUAL "")
      string(APPEND output "${text}")
      break()
    endif()
    string(FIND "${text}" "${matched}" start)
    string(LENGTH "${matched}" count)
    math(EXPR end "${start}+${count}")
    string(SUBSTRING "${text}" 0 ${start} prefix)
    string(SUBSTRING "${text}" ${end} -1 suffix)
    string(APPEND output "${prefix}")
    set(boundary "${previous}${prefix}")
    if(boundary MATCHES "[a-zA-Z0-9_.]$" OR suffix MATCHES "^[a-zA-Z0-9_.]")
      string(APPEND output "${matched}")
    else()
      string(REGEX REPLACE "_[kK][nN][dD]1?$" "" literal "${matched}")
      string(REGEX REPLACE "[dD]" "e" literal "${literal}")
      string(APPEND output "mpreal(\"${literal}\")")
    endif()
    set(previous "${matched}")
    set(text "${suffix}")
  endwhile()
  set(${result} "${output}" PARENT_SCOPE)
endfunction()

function(sw_outside_strings text result)
  set(output "")
  while(NOT text STREQUAL "")
    string(REGEX MATCH "^[^'\"]+" prefix "${text}")
    if(NOT prefix STREQUAL "")
      string(LENGTH "${prefix}" count)
      string(SUBSTRING "${text}" ${count} -1 text)
      sw_numeric_literals("${prefix}" prefix)
      string(APPEND output "${prefix}")
    endif()
    if(NOT text STREQUAL "")
      string(REGEX MATCH "^('(''|[^'])*'|\"(\"\"|[^\"])*\")" quoted "${text}")
      if(quoted STREQUAL "")
        message(FATAL_ERROR "Unterminated Fortran string: ${text}")
      endif()
      string(LENGTH "${quoted}" count)
      string(SUBSTRING "${text}" ${count} -1 text)
      string(APPEND output "${quoted}")
    endif()
  endwhile()
  set(${result} "${output}" PARENT_SCOPE)
endfunction()

function(sw_translate_statement statement result)
  string(TOLOWER "${statement}" lower)
  if(lower MATCHES "^!\\$omp")
    set(${result} "${statement}" PARENT_SCOPE)
    return()
  endif()
  if(lower MATCHES "^[ \t]*[0-9]*[ \t]*format[ \t]*\\(")
    set(${result} "" PARENT_SCOPE)
    return()
  endif()
  if(lower MATCHES "(^|[^a-z0-9_])(write|open|close)[ \t]*\\(")
    set(label "")
    if(statement MATCHES "^[ \t]*([0-9]+)[ \t]+")
      set(label "${CMAKE_MATCH_1} ")
    endif()
    set(${result} "${label}continue" PARENT_SCOPE)
    return()
  endif()
  if(lower MATCHES "^([ \t]*[0-9]*[ \t]*)(real|complex)[ \t]*\\([ \t]*knd1?[ \t]*\\)")
    set(prefix "${CMAKE_MATCH_1}")
    set(kind "${CMAKE_MATCH_2}")
    string(LENGTH "${CMAKE_MATCH_0}" count)
    string(SUBSTRING "${statement}" ${count} -1 remainder)
    if(remainder MATCHES "::" AND remainder MATCHES "=" AND NOT remainder MATCHES "=>")
      string(REGEX REPLACE "[ \t]*=[ \t]*${SW_FLOAT}[ \t]*$" "" remainder "${remainder}")
    endif()
    set(statement "${prefix}type(mp_${kind})${remainder}")
  endif()
  string(REGEX REPLACE "[sS][eE][lL][eE][cC][tT][eE][dD]_[rR][eE][aA][lL]_[kK][iI][nN][dD][ \t]*\\([ \t]*[0-9]+[ \t]*\\)" "16" statement "${statement}")
  while(statement MATCHES "${SW_MODULE_NAME}")
    string(REGEX REPLACE "${SW_MODULE_NAME}" "\\1\\2_\\3_mpfr\\4" statement "${statement}")
  endwhile()
  sw_complex_literals("${statement}" statement)
  sw_convert_calls("${statement}" statement)
  sw_outside_strings("${statement}" statement)
  string(TOLOWER "${statement}" lower)
  if(lower MATCHES "(^|[^a-z0-9_])minacc[ \t]*=[ \t]*[0-9]+[ \t]*$")
    string(REGEX REPLACE "[mM][iI][nN][aA][cC][cC][ \t]*=[ \t]*[0-9]+[ \t]*$" "minacc = max(8, int(mpfr_bits * 0.3010299956639812d0) - 8)" statement "${statement}")
  endif()
  if(lower MATCHES "cache_real_equal[ \t]*=")
    set(statement "cache_real_equal = a == b")
  endif()
  if(lower MATCHES "^real_bytes[ \t]*=[ \t]*storage_size")
    set(statement "real_bytes = (storage_size(mpreal(\"0\"),kind=c_int64_t)+7_c_int64_t)/8_c_int64_t + 88_c_int64_t + 8_c_int64_t*((int(mpfr_bits,c_int64_t)+63_c_int64_t)/64_c_int64_t)")
  endif()
  set(${result} "${statement}" PARENT_SCOPE)
endfunction()

function(sw_dimension dimension result)
  if(NOT dimension MATCHES "^[a-zA-Z0-9_ \t+]+$")
    message(FATAL_ERROR "Unsupported main workspace dimension: ${dimension}")
  endif()
  set(output "")
  while(NOT dimension STREQUAL "")
    string(REGEX MATCH "[a-zA-Z][a-zA-Z0-9_]*|[0-9]+" token "${dimension}")
    if(token STREQUAL "")
      string(APPEND output "${dimension}")
      break()
    endif()
    string(FIND "${dimension}" "${token}" start)
    string(LENGTH "${token}" count)
    math(EXPR end "${start}+${count}")
    string(SUBSTRING "${dimension}" 0 ${start} prefix)
    string(SUBSTRING "${dimension}" ${end} -1 dimension)
    if(token MATCHES "^[a-zA-Z]")
      string(APPEND output "${prefix}int(${token},c_int64_t)")
    else()
      string(APPEND output "${prefix}${token}_c_int64_t")
    endif()
  endwhile()
  set(${result} "${output}" PARENT_SCOPE)
endfunction()

function(sw_workspace statements_name arguments_result functions_result)
  set(in_main FALSE)
  set(keys)
  set(arguments)
  foreach(statement IN LISTS ${statements_name})
    string(TOLOWER "${statement}" lower)
    if(lower MATCHES "^subroutine[ \t]+main[ \t]*\\(")
      set(in_main TRUE)
    elseif(in_main AND lower MATCHES "^end[ \t]+subroutine")
      set(in_main FALSE)
    endif()
    set(entries)
    set(declared_kind)
    if(in_main AND lower MATCHES "^(real|complex)[ \t]*\\([ \t]*knd1?[ \t]*\\)")
      set(declared_kind "${CMAKE_MATCH_1}")
      string(LENGTH "${CMAKE_MATCH_0}" count)
      string(SUBSTRING "${statement}" ${count} -1 entries)
      string(REGEX REPLACE "^.*::" "" entries "${entries}")
      sw_split_arguments("${entries}" entries)
    elseif(in_main AND lower MATCHES "^allocate[ \t]*\\((.*)\\)$")
      sw_split_arguments("${CMAKE_MATCH_1}" entries)
    endif()
    if(entries)
      foreach(entry IN LISTS entries)
        if(entry MATCHES "^([a-zA-Z0-9_]+)[ \t]*\\((.*)\\)$")
          set(name "${CMAKE_MATCH_1}")
          set(dimensions "${CMAKE_MATCH_2}")
          set(kind "${declared_kind}")
          if(NOT kind)
            set(kind "${deferred_${name}_kind}")
          endif()
          if(NOT kind)
            continue()
          endif()
          if(dimensions MATCHES ":")
            set(deferred_${name}_kind "${kind}")
            continue()
          endif()
          sw_split_arguments("${dimensions}" dimensions)
          list(JOIN dimensions "," dimension_key)
          string(MD5 key "${dimension_key}")
          if(NOT DEFINED array_${key}_copies)
            list(APPEND keys "${key}")
            set(array_${key}_copies 0)
            set(array_${key}_dimensions "${dimensions}")
            string(REGEX MATCHALL "[a-zA-Z][a-zA-Z0-9_]*" names "${dimension_key}")
            list(APPEND arguments ${names})
          endif()
          if(kind STREQUAL "complex")
            math(EXPR array_${key}_copies "${array_${key}_copies}+4")
          else()
            math(EXPR array_${key}_copies "${array_${key}_copies}+2")
          endif()
        endif()
      endforeach()
    endif()
  endforeach()
  if(NOT keys)
    message(FATAL_ERROR "No main workspace declarations found")
  endif()
  list(REMOVE_DUPLICATES arguments)
  list(SORT arguments)
  list(JOIN arguments ", " argument_text)
  set(output "! mpfr_workspace_ok includes main temporaries, cache copies, and allocator overhead.\nlogical function mpfr_workspace_ok(${argument_text}) result(allowed)\ninteger, intent(in) :: ${argument_text}\ntype(mp_real) :: element\ninteger(c_int64_t) :: total, element_bytes\nallowed = .false.\nmpfr_status = 4\ntotal = 1048576_c_int64_t\nif (total > mpfr_workspace_limit_bytes) return\nif (max(0_c_int64_t,auxiliary_cache_limit_bytes) > mpfr_workspace_limit_bytes-total) return\ntotal = total+max(0_c_int64_t,auxiliary_cache_limit_bytes)\nelement_bytes = (storage_size(element, kind=c_int64_t)+7_c_int64_t)/8_c_int64_t &\n  + 88_c_int64_t + 8_c_int64_t*((int(mpfr_bits,c_int64_t)+63_c_int64_t)/64_c_int64_t)\n")
  foreach(key IN LISTS keys)
    set(converted)
    foreach(dimension IN LISTS array_${key}_dimensions)
      sw_dimension("${dimension}" dimension)
      list(APPEND converted "${dimension}")
    endforeach()
    list(JOIN converted "," dimensions)
    string(APPEND output "if (.not.mpfr_account_workspace(total,element_bytes,${array_${key}_copies}_c_int64_t,[${dimensions}])) return\n")
  endforeach()
  string(APPEND output "mpfr_status = 0\nallowed = .true.\nend function mpfr_workspace_ok\nlogical function mpfr_account_workspace(total,element_bytes,copies,dimensions) result(allowed)\ninteger(c_int64_t), intent(inout) :: total\ninteger(c_int64_t), intent(in) :: element_bytes,copies,dimensions(:)\ninteger(c_int64_t) :: available,bytes,dimension\ninteger :: index\nallowed = .false.\navailable = mpfr_workspace_limit_bytes-total\nif (element_bytes <= 0.or.copies <= 0.or.available < 0) return\nif (copies > available/element_bytes) return\nbytes = copies*element_bytes\ndo index=1,size(dimensions)\ndimension=dimensions(index)\nif (dimension < 0) return\nif (dimension == 0) then\nallowed=.true.\nreturn\nend if\nif (dimension > available/bytes) return\nbytes=bytes*dimension\nend do\ntotal=total+bytes\nallowed=.true.\nend function mpfr_account_workspace\n")
  set(${arguments_result} "${argument_text}" PARENT_SCOPE)
  set(${functions_result} "${output}" PARENT_SCOPE)
endfunction()

function(sw_translate source result)
  sw_statements("${source}" statements)
  sw_workspace(statements workspace_arguments workspace_functions)
  set(output "! Generated from the maintained Fortran source; edit that source instead.\n")
  set(pending_implicit FALSE)
  set(clearing_qleg FALSE)
  foreach(statement IN LISTS statements)
    string(TOLOWER "${statement}" lower)
    if(lower MATCHES "^subroutine[ \t]+clear_qleg_cache_slot[ \t]*\\(")
      set(clearing_qleg TRUE)
    elseif(lower MATCHES "^end[ \t]+subroutine")
      set(clearing_qleg FALSE)
    endif()
    if(clearing_qleg AND lower MATCHES "^(qleg_cache\\(idx\\)%(x1|qdml|qml|termpq))[ \t]*=[ \t]*0\\.0_knd$")
      string(APPEND output "if(allocated(${CMAKE_MATCH_1}%data)) deallocate(${CMAKE_MATCH_1}%data)\n")
      continue()
    endif()
    sw_translate_statement("${statement}" converted)
    if(converted STREQUAL "")
      continue()
    endif()
    string(TOLOWER "${converted}" lower)
    if(pending_implicit AND NOT lower MATCHES "^use([^a-z0-9_]|$)")
      string(APPEND output "implicit type(mp_real) (a-h,o-z)\n")
      set(pending_implicit FALSE)
    endif()
    if(lower MATCHES "^module[ \t]+[a-z0-9_]+_swf_mpfr[ \t]*$")
      string(APPEND output "${converted}\nuse, intrinsic :: iso_c_binding, only: c_int64_t\nuse spheroidal_mpfr_real\nuse spheroidal_mpfr_complex\n")
      set(pending_implicit TRUE)
    elseif(lower MATCHES "^call[ \t]+main[ \t]*\\(")
      string(APPEND output "if (.not.mpfr_workspace_ok(${workspace_arguments})) return\n${converted}\n")
    elseif(lower MATCHES "^end[ \t]+module[ \t]+[a-z0-9_]+_swf_mpfr")
      string(APPEND output "${workspace_functions}subroutine mpfr_clear_caches()\ninteger :: slot\ndo slot = 1, pleg_cache_slots\ncall clear_pleg_cache_slot(slot)\nend do\n")
      if(source MATCHES "qleg_cache_slots")
        string(APPEND output "do slot = 1, qleg_cache_slots\ncall clear_qleg_cache_slot(slot)\nend do\n")
      endif()
      string(APPEND output "if(allocated(gauss_cache%x)) deallocate(gauss_cache%x)\nif(allocated(gauss_cache%w)) deallocate(gauss_cache%w)\ngauss_cache%bytes = 0_int64\ngauss_cache%valid = .false.\nend subroutine mpfr_clear_caches\n${converted}\n")
    else()
      string(APPEND output "${converted}\n")
    endif()
  endforeach()
  set(${result} "${output}" PARENT_SCOPE)
endfunction()

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
if(NOT DEFINED GEOMETRIES)
  set(GEOMETRIES prolate oblate complex_prolate complex_oblate)
endif()
foreach(stem IN LISTS GEOMETRIES)
  file(READ "${CMAKE_CURRENT_LIST_DIR}/${stem}_swf_quad.f90" source)
  sw_translate("${source}" generated)
  file(WRITE "${OUTPUT_DIR}/${stem}_swf_mpfr.f90" "${generated}")
endforeach()
